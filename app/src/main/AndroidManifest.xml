<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for HTTPS wallet-service data transport (KF boot, witnesses,
         watchers, account operations, and OOBIs) under the v2 runtime
         requirements contract. Cleartext transport stays prohibited. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeriWallet"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- QR scanner (zxing-android-embedded): keep it portrait so returning
             from a scan never forces MainActivity through a rotation restart. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="screenOrientation" />

        <!-- Second launcher icon: the native-capabilities demo page in the same
             hardened WebView host. Its own task affinity keeps it from being
             merged with (and hidden behind) an already-open wallet task. -->
        <activity
            android:name=".DemoActivity"
            android:exported="true"
            android:label="@string/demo_launcher_label"
            android:taskAffinity="org.kerifoundation.fortandroid.demo"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>